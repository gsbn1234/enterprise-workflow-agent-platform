# Copy this file to .env.hr-demo before deploying:
#   cp .env.hr-demo.example .env.hr-demo
#
# Then edit the public URLs and secrets. Do not commit .env.hr-demo.

AGENT_HOST_PORT=8010
RAG_BUILD_CONTEXT=../enterprise-knowledge-rag
RAG_HOST_PORT=8000
TICKET_HOST_PORT=8020
POSTGRES_HOST_PORT=5432
AGENT_POSTGRES_HOST_PORT=5433
AGENT_ENV=staging
AGENT_PUBLIC_BASE_URL=http://127.0.0.1:8010
AGENT_CORS_ORIGINS=http://127.0.0.1:8010
AGENT_TRUSTED_HOSTS=
AGENT_ENABLE_SECURITY_HEADERS=true
AGENT_TRACEPARENT_ENABLED=true
AGENT_METRICS_ENABLED=true
AGENT_METRICS_AUTH_REQUIRED=true
AGENT_SERVICE_NAME=enterprise-workflow-agent
AGENT_SERVICE_VERSION=hr-demo
AGENT_LOG_LEVEL=INFO
AGENT_LOG_FORMAT=json
AGENT_OTEL_ENABLED=false
AGENT_OTEL_SERVICE_NAME=enterprise-workflow-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
AGENT_OTEL_EXPORT_CONSOLE=false
AGENT_TENANT_ISOLATION_ENABLED=true
AGENT_DEFAULT_TENANT_ID=hr-demo
AGENT_AUTO_MIGRATE=false

# Replace with long random values before sharing the demo.
AGENT_AUTH_TOKEN_SECRET=replace-with-a-long-random-agent-secret
RAG_AUTH_TOKEN_SECRET=replace-with-a-long-random-rag-secret
RAG_SERVICE_TOKEN=replace-with-a-long-random-agent-to-rag-service-token
TICKET_SERVICE_TOKEN=replace-with-a-long-random-ticket-token
TICKET_DASHBOARD_USERNAME=ticket-admin
TICKET_DASHBOARD_PASSWORD=replace-with-a-long-random-dashboard-password
AGENT_OIDC_ENABLED=false
AGENT_OIDC_ISSUER=https://idp.example.com
AGENT_OIDC_AUDIENCE=agent-platform
AGENT_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
AGENT_OIDC_BROWSER_LOGIN_ENABLED=false
AGENT_OIDC_AUTHORIZATION_URL=https://idp.example.com/oauth2/v1/authorize
AGENT_OIDC_TOKEN_URL=https://idp.example.com/oauth2/v1/token
AGENT_OIDC_CLIENT_ID=agent-platform
AGENT_OIDC_CLIENT_SECRET=
AGENT_OIDC_REDIRECT_URI=
AGENT_OIDC_SCOPES=openid,profile,email
AGENT_OIDC_ALGORITHMS=RS256
AGENT_OIDC_TENANT_CLAIM=tenant_id
AGENT_OIDC_ADMIN_GROUPS=agent-admins
AGENT_OIDC_MANAGER_GROUPS=agent-approvers
AGENT_OIDC_DEFAULT_ROLE=employee
AGENT_OIDC_DEFAULT_DEPARTMENT=Operations
AGENT_LOGIN_MAX_FAILURES=5
AGENT_LOGIN_WINDOW_MINUTES=15
AGENT_LOGIN_LOCKOUT_MINUTES=15
AGENT_QUEUE_BACKEND=redis
AGENT_REDIS_QUEUE_NAME=agent:workflow_jobs
AGENT_REDIS_BLOCK_TIMEOUT_SECONDS=5
AGENT_OUTBOX_DISPATCHER_ENABLED=true
AGENT_OUTBOX_DISPATCH_INTERVAL_SECONDS=5
AGENT_OUTBOX_DISPATCH_BATCH_SIZE=20
AGENT_OUTBOX_MAX_ATTEMPTS=5
AGENT_OUTBOX_RETRY_BACKOFF_SECONDS=30
AGENT_AUDIT_RETENTION_DAYS=180
AGENT_EVAL_REPORT_RETENTION_DAYS=180
AGENT_EXTERNAL_OUTBOX_RETENTION_DAYS=90
AGENT_EMAIL_RETENTION_DAYS=90
AGENT_WORKFLOW_JOB_RETENTION_DAYS=30
AGENT_LOGIN_ATTEMPT_RETENTION_DAYS=180

# IMPORTANT: set this to the URL HR can open.
# Local:  http://127.0.0.1:8020
# Cloud:  http://YOUR_SERVER_IP:8020
# Domain: https://ticket-demo.example.com
TICKET_SERVICE_PUBLIC_BASE_URL=http://127.0.0.1:8020

# Agent production database.
AGENT_POSTGRES_DB=agent
AGENT_POSTGRES_USER=agent
AGENT_POSTGRES_PASSWORD=agent_password
AGENT_POSTGRES_MIGRATION_USER=agent
AGENT_POSTGRES_MIGRATION_PASSWORD=agent_password
AGENT_POSTGRES_WORKER_USER=agent
AGENT_POSTGRES_WORKER_PASSWORD=agent_password
AGENT_POSTGRES_READONLY_USER=agent
AGENT_POSTGRES_READONLY_PASSWORD=agent_password
AGENT_POSTGRES_SCHEMA=agent_app
AGENT_POSTGRES_RLS_ENABLED=true
# Optional hardening: set after creating and granting this PostgreSQL role to the runtime user.
AGENT_POSTGRES_RLS_BYPASS_ROLE=

# RAG PostgreSQL / pgvector.
RAG_POSTGRES_DB=rag
RAG_POSTGRES_USER=rag
RAG_POSTGRES_PASSWORD=rag_password
RAG_POSTGRES_SCHEMA=rag_app
RAG_PGVECTOR_NAMESPACE=hr_demo

# Keep RAG offline-friendly for HR demos.
RAG_EMBEDDING_PROVIDER=local_hash
RAG_LLM_PROVIDER=local_extractive
RAG_RERANK_PROVIDER=none
RAG_JUDGE_PROVIDER=local_rule
RAG_AUTH_REQUIRED=false

# Optional Qwen / Alibaba Cloud Model Studio LLM adapter.
# Enable this when you want the Agent to use Qwen for intent planning
# and polished Markdown final answers. Do not commit real keys.
AGENT_LLM_ENABLED=false
AGENT_LLM_PROVIDER=qwen
AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_LLM_API_KEY=
# DASHSCOPE_API_KEY=
AGENT_LLM_MODEL=qwen-plus
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_LLM_TEMPERATURE=0.2
AGENT_LLM_MAX_TOKENS=900
AGENT_LLM_PLANNER_ENABLED=false
AGENT_LLM_FINAL_ANSWER_ENABLED=false
AGENT_LLM_MULTI_AGENT_REASONING_ENABLED=false
AGENT_LLM_PLANNER_MIN_CONFIDENCE=0.55

# Keep email safe by default. This records sent emails in the Agent DB
# without using your private mailbox or SMTP authorization code.
AGENT_EMAIL_PROVIDER=mock
AGENT_EMAIL_ALLOWLIST=@example.com

# Optional real SMTP demo. Enable only with a dedicated demo mailbox.
# AGENT_EMAIL_PROVIDER=smtp
# AGENT_EMAIL_ALLOWLIST=hr@example.com,@your-demo-domain.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=agent.demo@example.com
# SMTP_PASSWORD=replace-with-demo-app-password
# SMTP_FROM_EMAIL=agent.demo@example.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
