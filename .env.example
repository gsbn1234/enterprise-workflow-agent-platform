AGENT_APP_NAME=Enterprise Workflow Agent Platform
AGENT_ENV=development
AGENT_PUBLIC_BASE_URL=http://127.0.0.1:8010
AGENT_CORS_ORIGINS=http://127.0.0.1:8010
AGENT_TRUSTED_HOSTS=
AGENT_ENABLE_SECURITY_HEADERS=true
AGENT_TRACEPARENT_ENABLED=true
AGENT_METRICS_ENABLED=true
AGENT_METRICS_AUTH_REQUIRED=false
AGENT_SERVICE_NAME=enterprise-workflow-agent
AGENT_SERVICE_VERSION=local
AGENT_LOG_LEVEL=INFO
AGENT_LOG_FORMAT=plain
AGENT_OTEL_ENABLED=false
AGENT_OTEL_SERVICE_NAME=enterprise-workflow-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
AGENT_OTEL_EXPORT_CONSOLE=false
AGENT_DB_BACKEND=sqlite
AGENT_DB_PATH=data/agent_platform.sqlite3
# Production option:
# AGENT_DB_BACKEND=postgres
# AGENT_DATABASE_URL=postgresql://agent:agent_password@127.0.0.1:5433/agent
# AGENT_MIGRATION_DATABASE_URL=postgresql://agent_migrator:change-me@127.0.0.1:5433/agent
# AGENT_WORKER_DATABASE_URL=postgresql://agent_worker:change-me@127.0.0.1:5433/agent
# AGENT_READONLY_DATABASE_URL=postgresql://agent_readonly:change-me@127.0.0.1:5433/agent
# AGENT_POSTGRES_SCHEMA=agent_app
AGENT_POSTGRES_RLS_ENABLED=false
AGENT_POSTGRES_RLS_BYPASS_ROLE=
AGENT_AUTO_MIGRATE=true
AGENT_AUTO_SEED=true
AGENT_MAX_STEPS=8
AGENT_APPROVAL_AMOUNT_THRESHOLD=500
AGENT_EXTERNAL_EMAIL_REQUIRES_APPROVAL=true
AGENT_JOB_POLL_INTERVAL_SECONDS=2
AGENT_JOB_MAX_ATTEMPTS=3
AGENT_QUEUE_BACKEND=db
AGENT_REDIS_URL=redis://127.0.0.1:6379/0
AGENT_REDIS_QUEUE_NAME=agent:workflow_jobs
AGENT_REDIS_BLOCK_TIMEOUT_SECONDS=5
AGENT_TOOL_RETRY_MAX_ATTEMPTS=2
AGENT_TOOL_RETRY_BACKOFF_SECONDS=0.2
AGENT_OUTBOX_DISPATCHER_ENABLED=false
AGENT_OUTBOX_DISPATCH_INTERVAL_SECONDS=5
AGENT_OUTBOX_DISPATCH_BATCH_SIZE=20
AGENT_OUTBOX_MAX_ATTEMPTS=5
AGENT_OUTBOX_RETRY_BACKOFF_SECONDS=30
AGENT_TENANT_ISOLATION_ENABLED=false
AGENT_DEFAULT_TENANT_ID=default
AGENT_AUTH_REQUIRED=false
AGENT_AUTH_TOKEN_SECRET=change-this-local-secret
AGENT_ACCESS_TOKEN_EXPIRE_MINUTES=480
AGENT_PASSWORD_HASH_ITERATIONS=260000
AGENT_OIDC_ENABLED=false
AGENT_OIDC_ISSUER=https://idp.example.com
AGENT_OIDC_AUDIENCE=agent-platform
AGENT_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
AGENT_OIDC_BROWSER_LOGIN_ENABLED=false
AGENT_OIDC_AUTHORIZATION_URL=https://idp.example.com/oauth2/v1/authorize
AGENT_OIDC_TOKEN_URL=https://idp.example.com/oauth2/v1/token
AGENT_OIDC_CLIENT_ID=agent-platform
AGENT_OIDC_CLIENT_SECRET=
AGENT_OIDC_REDIRECT_URI=
AGENT_OIDC_SCOPES=openid,profile,email
AGENT_OIDC_ALGORITHMS=RS256
AGENT_OIDC_SUB_CLAIM=sub
AGENT_OIDC_DISPLAY_NAME_CLAIM=name
AGENT_OIDC_EMAIL_CLAIM=email
AGENT_OIDC_DEPARTMENT_CLAIM=department
AGENT_OIDC_ROLE_CLAIM=role
AGENT_OIDC_TENANT_CLAIM=tenant_id
AGENT_OIDC_GROUPS_CLAIM=groups
AGENT_OIDC_ADMIN_GROUPS=agent-admins
AGENT_OIDC_MANAGER_GROUPS=agent-approvers
AGENT_OIDC_DEFAULT_ROLE=employee
AGENT_OIDC_DEFAULT_DEPARTMENT=Operations
# Test-only shared-secret OIDC. Do not use HS256 for production SSO.
AGENT_OIDC_HS256_SECRET=
AGENT_LOGIN_MAX_FAILURES=5
AGENT_LOGIN_WINDOW_MINUTES=15
AGENT_LOGIN_LOCKOUT_MINUTES=15
AGENT_AUDIT_RETENTION_DAYS=0
AGENT_EVAL_REPORT_RETENTION_DAYS=0
AGENT_EXTERNAL_OUTBOX_RETENTION_DAYS=0
AGENT_EMAIL_RETENTION_DAYS=0
AGENT_WORKFLOW_JOB_RETENTION_DAYS=0
AGENT_LOGIN_ATTEMPT_RETENTION_DAYS=0

# Optional: connect this project to your existing RAG service.
# Example: http://127.0.0.1:8000
KNOWLEDGE_RAG_BASE_URL=

# External tool mode.
# mock = local sandbox records only.
# real = use configured real adapters. Keep approvals enabled for risky actions.
AGENT_TOOL_MODE=mock

# Real email adapter. Set AGENT_EMAIL_PROVIDER=smtp or AGENT_TOOL_MODE=real.
# AGENT_EMAIL_ALLOWLIST is required for real sends. Use your own test mailbox/domain.
AGENT_EMAIL_PROVIDER=mock
AGENT_EMAIL_ALLOWLIST=your-test@example.com,@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM_EMAIL=your-smtp-user@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Real ticket adapter: generic HTTP endpoint.
# The endpoint should accept POST JSON with title, description, customer_id, priority, owner_department.
# For local demos, start external_ticket_service.server on port 8020.
AGENT_TICKET_PROVIDER=mock
TICKET_API_URL=http://127.0.0.1:8020/api/tickets
TICKET_API_TOKEN=replace-with-token
TICKET_API_TIMEOUT_SECONDS=15
TICKET_HTTP_ID_FIELD=id
TICKET_HTTP_URL_FIELD=url

# Alternative real ticket adapter: Jira Cloud.
# Set AGENT_TICKET_PROVIDER=jira and fill these.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-jira-email@example.com
JIRA_API_TOKEN=replace-with-jira-api-token
JIRA_PROJECT_KEY=OPS
JIRA_ISSUE_TYPE=Task
